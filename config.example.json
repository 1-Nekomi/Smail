{
  "email": "your-number@qq.com",
  "password_env": "SMAIL_PASSWORD",
  "imap_host": "imap.qq.com",
  "imap_port": 993,
  "smtp_host": "smtp.qq.com",
  "smtp_port": 465,
  "folder": "INBOX",
  "output_dir": "downloads",
  "state_dir": "data",
  "poll_seconds": 60,
  "include_existing": false,
  "allowed_extensions": [".jpg", ".jpeg", ".png", ".gif", ".webp", ".pdf", ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx", ".txt", ".csv"],
  "allowed_mime_types": [],
  "policy": "matching",
  "include_inline": false,
  "max_attachment_mb": 25,
  "max_message_mb": 50,
  "notification": "desktop",
  "notification_email": "",
  "reply_enabled": true,
  "rejection_message": "您的邮件附件不符合接收要求，未予保存。原因：{reason}。支持的扩展名：{allowed_types}。"
}
